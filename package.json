{
  "name": "kirinuki-app",
  "productName": "Kirinuki",
  "version": "3.0.0",
  "private": true,
  "license": "Unlicense",
  "type": "module",
  "scripts": {
    "studio": "bash ./kirinuki.sh",
    "studio-server": "node --import tsx scripts/local-studio-server.ts",
    "studio-server:start": "node --import tsx scripts/local-studio-server.ts start",
    "studio-server:status": "node --import tsx scripts/local-studio-server.ts status",
    "studio-server:stop": "node --import tsx scripts/local-studio-server.ts stop",
    "public-shell:start": "node --import tsx scripts/public-shell-server.ts",
    "public-shell:check": "node --import tsx scripts/check-public-deployment.ts",
    "dev:web": "npm run build && node --import tsx scripts/local-studio-server.ts start --foreground",
    "dev:editor": "node --import tsx scripts/dev-web.ts",
    "desktop": "node --import tsx scripts/run-desktop.ts",
    "build": "node --import tsx scripts/build-web.ts",
    "build:web": "node --import tsx scripts/build-web.ts",
    "build:desktop": "node --import tsx scripts/build-desktop.ts",
    "tools:desktop": "node --import tsx scripts/prepare-desktop-tools.ts",
    "caption-gateway": "node --import tsx scripts/caption-gateway.ts",
    "caption-stack": "node --import tsx scripts/local-caption-stack.ts",
    "caption-stack:doctor": "node --import tsx scripts/local-caption-stack.ts doctor",
    "caption-stack:setup": "node --import tsx scripts/local-caption-stack.ts setup",
    "caption-stack:start": "node --import tsx scripts/local-caption-stack.ts start",
    "caption-stack:status": "node --import tsx scripts/local-caption-stack.ts status",
    "caption-stack:stop": "node --import tsx scripts/local-caption-stack.ts stop",
    "vod-runtime": "node --import tsx scripts/local-vod-runtime.ts",
    "vod-runtime:doctor": "node --import tsx scripts/local-vod-runtime.ts doctor",
    "vod-runtime:setup": "node --import tsx scripts/local-vod-runtime.ts setup",
    "vod-runtime:start": "node --import tsx scripts/local-vod-runtime.ts start",
    "vod-runtime:status": "node --import tsx scripts/local-vod-runtime.ts status",
    "vod-runtime:stop": "node --import tsx scripts/local-vod-runtime.ts stop",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.web.source.json",
    "migration:check": "node --import tsx scripts/check-typescript-migration.ts",
    "test": "node --import tsx scripts/run-tests.ts",
    "test:browser": "node --import tsx scripts/local-studio-browser-smoke.ts",
    "test:browser:public-shell": "node --import tsx scripts/public-shell-browser-smoke.ts",
    "test:package:web:reproducibility": "node --import tsx scripts/verify-web-package-reproducibility.ts",
    "test:package:desktop": "node --import tsx scripts/desktop-package-smoke.ts",
    "acceptance:localhost": "node --import tsx scripts/local-studio-user-acceptance.ts",
    "test:browser:live-embeds": "KIRINUKI_LIVE_EMBED_SMOKE=1 node --import tsx scripts/local-studio-browser-smoke.ts",
    "test:browser:live-vod": "KIRINUKI_LIVE_VOD_SMOKE=1 node --import tsx scripts/local-studio-live-vod-smoke.ts",
    "test:browser:live-vod-cut": "KIRINUKI_LIVE_VOD_SMOKE=1 KIRINUKI_LIVE_VOD_CUT_ONLY=1 node --import tsx scripts/local-studio-live-vod-smoke.ts",
    "test:liveness:live-vod": "KIRINUKI_EXTERNAL_VOD_LIVENESS_SMOKE=1 node --import tsx scripts/external-vod-liveness-smoke.ts",
    "validate": "node --import tsx scripts/validate-local-studio.ts",
    "license:check": "node --import tsx scripts/check-third-party-licenses.ts",
    "audit": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run migration:check && npm run build && npm run build:desktop && npm run validate && npm run license:check && npm test && npm run audit",
    "check:full": "npm run check && npm run test:browser",
    "package": "node --import tsx scripts/release-package.ts",
    "package:web": "node --import tsx scripts/package-web.ts",
    "package:linux": "node --import tsx scripts/package-linux-app.ts",
    "package:desktop": "node --import tsx scripts/package-desktop.ts",
    "streaming:companion:build": "node --import tsx scripts/build-streaming-companion.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "esbuild": "0.28.1",
    "mediabunny": "1.51.0",
    "tsx": "4.23.1"
  },
  "devDependencies": {
    "@electron/asar": "4.2.1",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@types/node": "20.19.43",
    "electron": "43.4.0",
    "typescript": "5.9.3"
  }
}
